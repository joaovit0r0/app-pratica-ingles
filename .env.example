# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). A chave "anon"/"publishable" é pública por natureza; os dados ficam protegidos pelas regras de acesso (RLS).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica
